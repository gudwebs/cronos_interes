    function buildExerciseSelectors() {
      [1, 2, 3].forEach((g) => {
        const container = document.getElementById(`ex-group-${g}`);
        container.innerHTML = "";
        EXERCISES.filter((e) => e.group === g).forEach((ex) => {
          const btn = document.createElement("button");
          btn.id = `ex-btn-${ex.id}`;
          btn.onclick = () => selectExercise(ex.id);
          btn.textContent = ex.shortTitle;
          container.appendChild(btn);
        });
      });
    }

    function selectExercise(id) {
      stopExercisePlayback();
      exState.activeId = id;
      exState.step = 1;
      renderExerciseView();
    }

    function setExerciseVariant(exId, variantId) {
      stopExercisePlayback();
      exState.variants[exId] = variantId;
      // Si el usuario cambia variante estando en paso 1 o 2, lo llevamos al paso 3 para ver la magia de las flechas inmediatamente
      if (exState.step < 3) exState.step = 3;
      renderExerciseView();
    }

    function setExerciseStep(step) {
      stopExercisePlayback();
      exState.step = Math.max(1, Math.min(4, step));
      renderExerciseView();
    }

    function prevExerciseStep() {
      if (exState.step > 1) setExerciseStep(exState.step - 1);
    }

    function nextExerciseStep() {
      if (exState.step < 4) setExerciseStep(exState.step + 1);
    }

    function stopExercisePlayback() {
      if (exState.playTimer) {
        clearInterval(exState.playTimer);
        exState.playTimer = null;
      }
      const btn = document.getElementById("btn-play-ex");
      if (btn) {
        btn.innerHTML = `
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z" />
          </svg>
          Reproducir Animación`;
      }
    }

    function playExerciseAnimation() {
      if (exState.playTimer) {
        stopExercisePlayback();
        return;
      }
      exState.step = 1;
      renderExerciseView();
      const btn = document.getElementById("btn-play-ex");
      btn.innerHTML = `⏸ Detener`;

      exState.playTimer = setInterval(() => {
        if (exState.step < 4) {
          exState.step += 1;
          renderExerciseView();
        } else {
          stopExercisePlayback();
        }
      }, 2100);
    }

    function renderExerciseView() {
      const ex = EXERCISES.find((e) => e.id === exState.activeId);
      const variant = exState.variants[ex.id] || null;
      const dyn = ex.getDynamic ? ex.getDynamic(variant) : ex;

      // Actualizar botones de lista
      EXERCISES.forEach((item) => {
        const b = document.getElementById(`ex-btn-${item.id}`);
        const active = item.id === ex.id;
        b.className = active
          ? "w-full text-left px-3 py-2 rounded-xl text-xs font-extrabold bg-slate-900 text-white shadow-sm transition-all"
          : "w-full text-left px-3 py-2 rounded-xl text-xs font-semibold bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200 transition-all";
      });

      // Cabecera
      const catBadge = document.getElementById("ex-category-badge");
