      return {
        color: "blue",
        dir: "ATRÁS (Azul · Valor Presente Vencida)",
        title: "Valor Presente de Anualidad Vencida Estándar",
        formula: `D = R · ${mathA("n", "i")} = R · ${frac("1 − (1 + i)<sup>−n</sup>", "i")}`,
        trick: "El primer pago es en t = 1 y a_n|i te deja parado exactamente en t = 0 (un periodo antes del primer pago)."
      };
