        q: "1. Tienes 6 pagos mensuales y el primer pago ocurre en el mes 4 (t = 4). Al calcular R · a₆|i, ¿en qué mes exacto cae ese valor?",
        options: [
          "En t = 0 (hoy)",
          "En t = 3 (un mes antes del primer pago)",
          "En t = 4 (en el primer pago)",
          "En t = 9 (en el último pago)"
        ],
        correct: 1,
        feedback: "¡Exacto! La fórmula vencida aₙ|i SIEMPRE te deja parado 1 periodo ANTES del primer pago. Como el primer pago es en t = 4, cae en t = 3 y luego solo regresas 3 meses a t = 0."
      },
      {
        q: "2. Te piden el saldo insoluto de una deuda de 5 pagos anuales «JUSTO ANTES de realizar el tercer pago». ¿Cuántos pagos debes incluir y qué fórmula usas?",
        options: [
          "Faltan 2 pagos (4 y 5), usando anualidad vencida a₂|i",
          "Faltan 3 pagos (3, 4 y 5), usando anualidad vencida a₃|i",
          "Faltan 3 pagos (3, 4 y 5), usando anualidad anticipada ä₃|i = a₃|i · (1+i)",
          "Ya se pagaron 3 pagos, así que uso s₃|i"
        ],
        correct: 2,
        feedback: "¡Trampa desactivada! Justo ANTES del pago 3 todavía debes ese pago (que vence hoy mismo), el 4 y el 5. Al haber un pago hoy en tu fecha focal, se evalúa como anticipada ä₃|i."
      },
      {
        q: "3. Haces depósitos mensuales para ahorrar un monto M y el problema dice: «El dinero se retira un mes después del último depósito». ¿Qué cambia en la fórmula?",
        options: [
          "Nada, uso sₙ|i normal",
          "Debo multiplicar sₙ|i por (1 + i) porque el último depósito gana 1 mes extra de interés",
          "Debo dividir sₙ|i entre (1 + i)",
          "Debo cambiar sₙ|i por aₙ|i"
        ],
        correct: 1,
        feedback: "¡Correcto! sₙ|i cae en el instante del último depósito. Al esperar un mes más antes de retirar, todo el bloque avanza 1 periodo multiplicando por (1 + i), convirtiéndose en s̈ₙ|i."
      },
      {
        q: "4. Te dan el precio de una mercancía ($99,000), el pago mensual ($17,200) y la tasa (1.2%), pero NO te dicen cuántos pagos son en total (n). Te piden el saldo insoluto tras el pago 4. ¿Qué método conviene?",
        options: [
          "Prospectivo, porque siempre es más corto",
          "Retrospectivo: D(1+i)⁴ − R·s₄|i, llevando todo lo que ya pasó hacia adelante hasta t = 4",
          "Anualidad diferida, regresando 4 meses",
          "No se puede resolver sin calcular primero el monto futuro total"
        ],
        correct: 1,
        feedback: "¡Brillante! Sin conocer n, no sabes cuántos pagos faltan en el futuro. El método retrospectivo solo necesita el pasado (D y los k = 4 pagos ya hechos) avanzados hacia t = 4."
      },
      {
        q: "5. Al despejar n en un préstamo obtienes n = 13.184 pagos. ¿Cuál es la diferencia entre hacer el pago extra X «al momento del último pago completo» vs «un mes después del último pago completo»?",
        options: [
          "Ninguna, el pago extra X es exactamente el mismo en ambos casos",
          "En el mes 13 el faltante en t=0 se multiplica por (1+i)¹³; un mes después (mes 14) se multiplica por (1+i)¹⁴",
          "En el mes 13 se usa (1+i)⁻¹³ y en el mes 14 se usa (1+i)⁻¹⁴",
          "Si es en el mes 13, se hacen 14 pagos completos en lugar de 13"
        ],
        correct: 1,
        feedback: "¡Dominado! En ambos casos son 13 pagos completos, pero el dinero faltante en t = 0 gana un mes más de intereses si lo pagas en el mes 14 en lugar de pagarlo junto al mes 13."
      }
    ];

    const quizAnswers = {}; // index -> chosenOptionIndex

    function answerQuiz(qIdx, optIdx) {
      if (quizAnswers[qIdx] !== undefined) return; // bloquea doble clic para mantener marcador honesto
      quizAnswers[qIdx] = optIdx;
      renderQuiz();
    }

    function resetQuiz() {
      Object.keys(quizAnswers).forEach((k) => delete quizAnswers[k]);
      renderQuiz();
    }

    function renderQuiz() {
      let score = 0;
      const container = document.getElementById("quiz-container");
      container.innerHTML = QUIZ_QUESTIONS.map((item, qIdx) => {
        const chosen = quizAnswers[qIdx];
        const answered = chosen !== undefined;
        const isCorrect = answered && chosen === item.correct;
        if (isCorrect) score++;

        const optsHtml = item.options
          .map((opt, optIdx) => {
            let cls = "w-full text-left px-3.5 py-2.5 rounded-xl border text-xs sm:text-sm font-medium transition-all ";
            if (!answered) {
              cls += "border-slate-200 bg-white hover:bg-violet-50 hover:border-violet-300 text-slate-700 cursor-pointer";
            } else if (optIdx === item.correct) {
              cls += "border-emerald-500 bg-emerald-50 text-emerald-900 font-bold";
            } else if (optIdx === chosen && optIdx !== item.correct) {
              cls += "border-rose-400 bg-rose-50 text-rose-900 font-bold";
            } else {
              cls += "border-slate-200 bg-slate-50 text-slate-400";
            }
            return `<button onclick="answerQuiz(${qIdx}, ${optIdx})" class="${cls}">${opt}</button>`;
          })
          .join("");

        const feedbackHtml = answered
          ? `<div class="mt-3 p-3 rounded-xl text-xs sm:text-sm leading-relaxed ${
              isCorrect ? "bg-emerald-50 border border-emerald-200 text-emerald-900" : "bg-rose-50 border border-rose-200 text-rose-900"
            }">
              <strong>${isCorrect ? "✓ ¡Correcto!" : "✗ Cuidado con la trampa:"}</strong> ${item.feedback}
            </div>`
          : "";

        return `
          <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4 sm:p-5">
            <p class="text-sm sm:text-base font-bold text-slate-900 mb-3">${item.q}</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-2">${optsHtml}</div>
            ${feedbackHtml}
          </div>
        `;
      }).join("");

      document.getElementById("quiz-score").textContent = score;
    }

    /* =========================================================================
       INICIALIZACIÓN
    ========================================================================= */
    window.addEventListener("DOMContentLoaded", () => {
      try {
        updateCompassButtons();
        renderCompassExplanation();
        renderCompassSVG(true);
        updateCompassPhasePills(2);

        buildExerciseSelectors();
        renderExerciseView();

        renderWizard();
        renderQuiz();
      } catch (err) {
        console.error("Error al inicializar el laboratorio:", err);
      }
    });
  </script>
