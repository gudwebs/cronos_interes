<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Laboratorio Visual: Teoría del Interés — Parcial 3</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Fuente Inter con fallback limpio -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg-app: #F8FAFC;
      --border-soft: #E2E8F0;
      --ff-orange: #EA580C;
      --ff-amber: #F97316;
      --back-blue: #2563EB;
      --fwd-green: #059669;
      --trap-purple: #7C3AED;
    }

    body {
      font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--bg-app);
      color: #0F172A;
      overflow-x: hidden;
    }

    /* Notación matemática limpia y ángulo actuarial */
    .math-expr {
      font-family: 'Cambria Math', 'Times New Roman', Georgia, serif;
      font-size: 1.08em;
      letter-spacing: 0.01em;
    }

    .act-angle {
      display: inline-block;
      border-top: 1.5px solid currentColor;
      border-right: 1.5px solid currentColor;
      padding: 0 3px 0 2px;
      margin-right: 1px;
      line-height: 1.05;
      font-size: 0.85em;
    }

    .math-frac {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      vertical-align: middle;
      margin: 0 3px;
      font-size: 0.92em;
      line-height: 1.15;
    }

    .math-frac .num {
      border-bottom: 1.4px solid currentColor;
      padding: 0 4px 1px;
    }

    .math-frac .den {
      padding: 1px 4px 0;
    }

    .ddot {
      position: relative;
      display: inline-block;
    }

    .ddot::before {
      content: "¨";
      position: absolute;
      top: -0.45em;
      left: 0.06em;
      font-size: 1em;
      font-weight: 700;
    }

    /* Animaciones SVG suaves */
    @keyframes drawPath {
      from {
        stroke-dashoffset: 1000;
      }
      to {
        stroke-dashoffset: 0;
      }
    }

    .animate-draw {
      stroke-dasharray: 1000;
      stroke-dashoffset: 1000;
      animation: drawPath 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .animate-draw-delayed {
      stroke-dasharray: 1000;
      stroke-dashoffset: 1000;
      animation: drawPath 0.95s cubic-bezier(0.22, 1, 0.36, 1) 0.55s forwards;
    }

    @keyframes pulsePin {
      0%, 100% {
        transform: scale(1);
        opacity: 0.95;
      }
      50% {
        transform: scale(1.22);
        opacity: 0.55;
      }
    }

    .pin-pulse {
      transform-box: fill-box;
      transform-origin: center;
      animation: pulsePin 1.7s ease-in-out infinite;
    }

    @keyframes fadeSlideUp {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .fade-in {
      animation: fadeSlideUp 0.3s ease-out forwards;
    }

    /* Scrollbar sutil */
    ::-webkit-scrollbar {
      height: 6px;
      width: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #F1F5F9;
    }
    ::-webkit-scrollbar-thumb {
      background: #CBD5E1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94A3B8;
    }

    /* Estilo tipo cuaderno sutil para el área del gráfico */
    .notebook-grid {
      background-color: #FFFFFF;
      background-image:
        linear-gradient(to right, rgba(226, 232, 240, 0.45) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(226, 232, 240, 0.45) 1px, transparent 1px);
      background-size: 24px 24px;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- Encabezado principal -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-orange-500 to-amber-600 text-white flex items-center justify-center shadow-sm shrink-0">
            <!-- Ícono brújula / línea de tiempo -->
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z" />
            </svg>
          </div>
          <div>
            <h1 class="text-lg sm:text-xl font-extrabold text-slate-900 tracking-tight leading-tight">
              Laboratorio Visual: Teoría del Interés — Parcial 3
            </h1>
            <p class="text-xs sm:text-sm text-slate-500 font-medium">
              Líneas de tiempo, Fecha Focal, Anualidades Diferidas, Pagos Extra y Saldos Insolutos
            </p>
          </div>
        </div>

        <!-- Leyenda semántica de colores siempre visible -->
        <div class="flex flex-wrap items-center gap-2 text-xs font-semibold">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-orange-50 text-orange-700 border border-orange-200">
            <span class="w-2.5 h-2.5 rounded-full bg-orange-600"></span> Fecha Focal (FF)
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 border border-blue-200">
            <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span> Atrás / VP (1+i)<sup>-k</sup>
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span> Adelante / VF (1+i)<sup>+k</sup>
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-violet-50 text-violet-700 border border-violet-200">
            <span class="w-2.5 h-2.5 rounded-full bg-violet-600"></span> Extra / Trampa
          </span>
        </div>
      </div>

      <!-- Navegación de 3 pestañas -->
      <nav class="mt-3.5 flex flex-wrap gap-2" role="tablist" aria-label="Secciones del laboratorio">
        <button id="tab-btn-1" onclick="switchTab(1)" role="tab" aria-selected="true"
          class="tab-btn px-4 py-2.5 rounded-xl text-sm font-bold transition-all flex items-center gap-2 bg-orange-600 text-white shadow-sm">
          <span>1.</span> Brújula: ¿Adelante o Atrás?
        </button>
        <button id="tab-btn-2" onclick="switchTab(2)" role="tab" aria-selected="false"
          class="tab-btn px-4 py-2.5 rounded-xl text-sm font-bold transition-all flex items-center gap-2 bg-slate-100 text-slate-700 hover:bg-slate-200">
          <span>2.</span> Tus 8 Ejercicios Paso a Paso
        </button>
        <button id="tab-btn-3" onclick="switchTab(3)" role="tab" aria-selected="false"
          class="tab-btn px-4 py-2.5 rounded-xl text-sm font-bold transition-all flex items-center gap-2 bg-slate-100 text-slate-700 hover:bg-slate-200">
          <span>3.</span> Mapa de Decisión y Detector de Trampas
        </button>
      </nav>
    </div>
  </header>

  <!-- Contenido principal -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <!-- ===================================================================== -->
    <!-- PESTAÑA 1: BRÚJULA ¿ADELANTE O ATRÁS?                                 -->
    <!-- ===================================================================== -->
    <section id="tab-panel-1" class="space-y-5 fade-in">
      <!-- Regla rápida de orientación -->
      <div class="bg-white rounded-2xl border border-slate-200 p-4 sm:p-5 shadow-sm">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          <div>
            <h2 class="text-lg font-extrabold text-slate-900">Simulador Interactivo de Líneas de Tiempo</h2>
            <p class="text-sm text-slate-600 mt-0.5">
              Elige un flujo, mueve la <span class="font-bold text-orange-600">Fecha Focal (FF)</span> y presiona <span class="font-bold text-slate-800">Animar Movimiento</span> para ver exactamente dónde te deja la fórmula y hacia dónde viaja el dinero.
            </p>
          </div>
          <button onclick="runCompassAnimation()"
            class="px-5 py-3 rounded-xl bg-orange-600 hover:bg-orange-700 active:scale-95 text-white font-bold text-sm shadow-sm transition-all flex items-center justify-center gap-2 shrink-0">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z" />
            </svg>
            Animar Movimiento (2 Fases)
          </button>
        </div>

        <!-- Controles: Tipo de flujo + Fórmula base + Slider FF -->
        <div class="mt-5 grid grid-cols-1 lg:grid-cols-12 gap-4 pt-4 border-t border-slate-100">
          <!-- Selector de flujo -->
          <div class="lg:col-span-5 space-y-2">
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500">1. Elige el tipo de flujo</label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2" id="compass-flow-buttons">
              <button onclick="setCompassFlow('single')" data-flow="single"
                class="flow-opt text-left px-3 py-2.5 rounded-xl border text-xs sm:text-sm font-semibold transition-all">
                Flujo Único<br /><span class="text-xs font-normal opacity-80">$1,000 en t = 5</span>
              </button>
              <button onclick="setCompassFlow('ordinary')" data-flow="ordinary"
                class="flow-opt text-left px-3 py-2.5 rounded-xl border text-xs sm:text-sm font-semibold transition-all">
                Anualidad Vencida<br /><span class="text-xs font-normal opacity-80">Pagos en t = 1..5</span>
              </button>
              <button onclick="setCompassFlow('due')" data-flow="due"
                class="flow-opt text-left px-3 py-2.5 rounded-xl border text-xs sm:text-sm font-semibold transition-all">
                Anualidad Anticipada<br /><span class="text-xs font-normal opacity-80">Pagos en t = 0..4</span>
              </button>
              <button onclick="setCompassFlow('deferred')" data-flow="deferred"
                class="flow-opt text-left px-3 py-2.5 rounded-xl border text-xs sm:text-sm font-semibold transition-all">
                Anualidad Diferida<br /><span class="text-xs font-normal opacity-80">Pagos en t = 4..8</span>
              </button>
            </div>
          </div>

          <!-- Selector de fórmula de agrupación (VP vs VF) -->
          <div class="lg:col-span-3 space-y-2">
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500">2. Agrupar con fórmula</label>
            <div id="compass-mode-wrapper" class="flex flex-col gap-2">
              <button id="compass-mode-vp" onclick="setCompassFormulaMode('vp')"
                class="px-3 py-2.5 rounded-xl border text-xs sm:text-sm font-bold text-left transition-all">
                Valor Presente (<span class="math-expr">a<sub><span class="act-angle">n</span>|i</sub></span> / <span class="math-expr"><span class="ddot">a</span><sub><span class="act-angle">n</span>|i</sub></span>)
              </button>
              <button id="compass-mode-vf" onclick="setCompassFormulaMode('vf')"
                class="px-3 py-2.5 rounded-xl border text-xs sm:text-sm font-bold text-left transition-all">
                Valor Futuro (<span class="math-expr">s<sub><span class="act-angle">n</span>|i</sub></span> / <span class="math-expr"><span class="ddot">s</span><sub><span class="act-angle">n</span>|i</sub></span>)
              </button>
            </div>
          </div>

          <!-- Control Fecha Focal -->
          <div class="lg:col-span-4 space-y-2">
            <div class="flex items-center justify-between">
              <label for="ff-slider" class="text-xs font-bold uppercase tracking-wider text-slate-500">3. Fecha Focal (FF)</label>
              <span id="ff-badge" class="px-2.5 py-0.5 rounded-full bg-orange-100 text-orange-800 text-xs font-extrabold">t = 0</span>
            </div>
            <input id="ff-slider" type="range" min="0" max="10" value="0" oninput="setCompassFF(parseInt(this.value))"
              class="w-full accent-orange-600 cursor-pointer h-2.5 bg-slate-200 rounded-lg" />
            <div class="flex justify-between text-[11px] font-semibold text-slate-400 px-0.5">
              <span>t=0</span><span>t=2</span><span>t=4</span><span>t=6</span><span>t=8</span><span>t=10</span>
            </div>
            <p class="text-xs text-slate-500">
              Tip: También puedes hacer <strong>clic directo en cualquier número (0..10)</strong> de la línea de tiempo.
            </p>
          </div>
        </div>
      </div>

      <!-- Lienzo SVG de la Brújula -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <!-- Barra de estado de las 2 fases -->
        <div class="px-4 sm:px-5 py-3 bg-slate-50 border-b border-slate-200 flex flex-wrap items-center justify-between gap-2 text-xs font-semibold">
          <div class="flex flex-wrap items-center gap-2">
            <span id="phase-pill-1" class="px-3 py-1 rounded-full bg-slate-200 text-slate-600 transition-all">
              Fase 1: Agrupación de pagos
            </span>
            <span class="text-slate-400">→</span>
            <span id="phase-pill-2" class="px-3 py-1 rounded-full bg-slate-200 text-slate-600 transition-all">
              Fase 2: Traslado a Fecha Focal
            </span>
          </div>
          <span id="compass-pin-hint" class="text-slate-600 font-bold"></span>
        </div>

        <div class="p-3 sm:p-5 notebook-grid overflow-x-auto">
          <svg id="compass-svg" viewBox="0 0 920 310" class="w-full min-w-[640px] h-auto select-none" aria-label="Línea de tiempo interactiva"></svg>
        </div>
      </div>

      <!-- Tarjeta explicativa dinámica -->
      <div id="compass-explanation" class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm"></div>
    </section>

    <!-- ===================================================================== -->
    <!-- PESTAÑA 2: TUS 8 EJERCICIOS PASO A PASO                               -->
    <!-- ===================================================================== -->
    <section id="tab-panel-2" class="hidden space-y-5 fade-in">
      <!-- Selector de ejercicios en 3 bloques -->
      <div class="bg-white rounded-2xl border border-slate-200 p-4 sm:p-5 shadow-sm">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <!-- Bloque 1: Diferidas -->
          <div>
            <p class="text-[11px] font-extrabold uppercase tracking-wider text-blue-700 mb-2 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-blue-600"></span> Bloque 1: Anualidades Diferidas
            </p>
            <div class="space-y-1.5" id="ex-group-1"></div>
          </div>
          <!-- Bloque 2: Tiempo y Pagos Extra -->
          <div>
            <p class="text-[11px] font-extrabold uppercase tracking-wider text-violet-700 mb-2 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-violet-600"></span> Bloque 2: Tiempo (n) y Pagos Extra
            </p>
            <div class="space-y-1.5" id="ex-group-2"></div>
          </div>
          <!-- Bloque 3: Saldos Insolutos -->
          <div>
            <p class="text-[11px] font-extrabold uppercase tracking-wider text-emerald-700 mb-2 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-600"></span> Bloque 3: Saldos Insolutos
            </p>
            <div class="space-y-1.5" id="ex-group-3"></div>
          </div>
        </div>
      </div>

      <!-- Panel activo del ejercicio -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <!-- Cabecera del ejercicio -->
        <div class="p-4 sm:p-6 border-b border-slate-200 bg-gradient-to-r from-slate-50 to-white">
          <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-4">
            <div class="space-y-1.5">
              <div class="flex flex-wrap items-center gap-2">
                <span id="ex-category-badge" class="px-2.5 py-0.5 rounded-full text-xs font-extrabold"></span>
                <span id="ex-result-badge" class="px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-xs font-extrabold"></span>
              </div>
              <h2 id="ex-title" class="text-lg sm:text-xl font-extrabold text-slate-900"></h2>
              <p id="ex-statement" class="text-sm text-slate-700 leading-relaxed max-w-4xl"></p>
            </div>

            <!-- Interruptor especial (solo aparece en Ej. 2 y Ej. 6) -->
            <div id="ex-variant-box" class="hidden shrink-0 bg-orange-50 border border-orange-200 rounded-xl p-3">
              <p id="ex-variant-label" class="text-[11px] font-extrabold uppercase tracking-wider text-orange-800 mb-2"></p>
              <div class="flex gap-1.5" id="ex-variant-buttons"></div>
            </div>
          </div>

          <!-- Datos extraídos rápido -->
          <div id="ex-data-pills" class="mt-3.5 flex flex-wrap gap-2"></div>
        </div>

        <!-- Barra de pasos del curso (1 a 4) y controles de reproducción -->
        <div class="px-4 sm:px-6 py-3.5 bg-slate-50 border-b border-slate-200 flex flex-col lg:flex-row lg:items-center justify-between gap-3">
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 flex-1" id="ex-step-tabs">
            <button onclick="setExerciseStep(1)" data-step="1" class="ex-step-pill px-3 py-2 rounded-xl text-xs font-bold border transition-all text-left">
              1. Línea de Tiempo
            </button>
            <button onclick="setExerciseStep(2)" data-step="2" class="ex-step-pill px-3 py-2 rounded-xl text-xs font-bold border transition-all text-left">
              2. Fecha Focal
            </button>
            <button onclick="setExerciseStep(3)" data-step="3" class="ex-step-pill px-3 py-2 rounded-xl text-xs font-bold border transition-all text-left">
              3. Dirección de Flujos
            </button>
            <button onclick="setExerciseStep(4)" data-step="4" class="ex-step-pill px-3 py-2 rounded-xl text-xs font-bold border transition-all text-left">
              4. Ecuación y Despeje
            </button>
          </div>

          <div class="flex items-center gap-2 shrink-0">
            <button onclick="prevExerciseStep()" id="btn-prev-step"
              class="px-3 py-2 rounded-xl bg-white border border-slate-300 hover:bg-slate-100 text-slate-700 text-xs font-bold transition-all">
              ← Anterior
            </button>
            <button onclick="nextExerciseStep()" id="btn-next-step"
              class="px-3 py-2 rounded-xl bg-white border border-slate-300 hover:bg-slate-100 text-slate-700 text-xs font-bold transition-all">
              Siguiente →
            </button>
            <button onclick="playExerciseAnimation()" id="btn-play-ex"
              class="px-4 py-2 rounded-xl bg-orange-600 hover:bg-orange-700 text-white text-xs font-bold shadow-sm transition-all flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z" />
              </svg>
              Reproducir Animación
            </button>
          </div>
        </div>

        <!-- Gráfico SVG del Ejercicio -->
        <div class="p-3 sm:p-5 notebook-grid border-b border-slate-200 overflow-x-auto">
          <svg id="exercise-svg" viewBox="0 0 920 315" class="w-full min-w-[660px] h-auto select-none" aria-label="Diagrama animado del ejercicio"></svg>
        </div>

        <!-- Explicación del paso actual + Ecuación paso a paso -->
        <div class="p-5 sm:p-6 grid grid-cols-1 lg:grid-cols-12 gap-5">
          <div class="lg:col-span-5 space-y-3">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-100 text-orange-800 text-xs font-extrabold" id="ex-step-label"></div>
            <h3 id="ex-step-heading" class="text-base sm:text-lg font-extrabold text-slate-900"></h3>
            <p id="ex-step-text" class="text-sm text-slate-700 leading-relaxed"></p>
            <div id="ex-note-callout" class="hidden rounded-xl p-3.5 text-xs sm:text-sm leading-relaxed"></div>
          </div>

          <div class="lg:col-span-7 bg-slate-50 rounded-2xl border border-slate-200 p-4 sm:p-5">
            <p class="text-xs font-extrabold uppercase tracking-wider text-slate-500 mb-3">Desarrollo Matemático (Método de tus notas)</p>
            <div id="ex-math-steps" class="space-y-3 text-sm text-slate-800"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- PESTAÑA 3: MAPA DE DECISIÓN Y DETECTOR DE TRAMPAS                     -->
    <!-- ===================================================================== -->
    <section id="tab-panel-3" class="hidden space-y-6 fade-in">

      <!-- SECCIÓN A: ASISTENTE "¿QUÉ FÓRMULA USO?" -->
      <div class="bg-white rounded-2xl border border-slate-200 p-5 sm:p-6 shadow-sm">
        <div class="mb-5">
          <span class="px-2.5 py-0.5 rounded-full bg-orange-100 text-orange-800 text-xs font-extrabold">Sección A</span>
          <h2 class="text-lg sm:text-xl font-extrabold text-slate-900 mt-1">Asistente Interactivo: "¿Qué fórmula uso?"</h2>
          <p class="text-sm text-slate-600">Responde estas 3 preguntas rápidas de tu problema y obtén al instante la fórmula ganadora, la dirección y el truco clave.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
          <!-- Pregunta 1 -->
          <div class="space-y-2">
            <p class="text-xs font-extrabold uppercase tracking-wider text-slate-500">1. ¿Qué estás buscando?</p>
            <div class="space-y-2" id="wiz-q1"></div>
          </div>
          <!-- Pregunta 2 -->
          <div class="space-y-2">
            <p class="text-xs font-extrabold uppercase tracking-wider text-slate-500">2. ¿Qué datos conoces?</p>
            <div class="space-y-2" id="wiz-q2"></div>
          </div>
          <!-- Pregunta 3 -->
          <div class="space-y-2">
            <p class="text-xs font-extrabold uppercase tracking-wider text-slate-500">3. ¿Cuándo ocurren los pagos / momento?</p>
            <div class="space-y-2" id="wiz-q3"></div>
          </div>
        </div>

        <!-- Resultado del asistente -->
        <div id="wiz-result" class="mt-6 rounded-2xl border-2 p-5 transition-all"></div>
      </div>

      <!-- SECCIÓN B: MINI-RETO DETECTOR DE TRAMPAS -->
      <div class="bg-white rounded-2xl border border-slate-200 p-5 sm:p-6 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5">
          <div>
            <span class="px-2.5 py-0.5 rounded-full bg-violet-100 text-violet-800 text-xs font-extrabold">Sección B · 5 Preguntas Clave</span>
            <h2 class="text-lg sm:text-xl font-extrabold text-slate-900 mt-1">Mini-Reto: Detector de Trampas de Examen</h2>
            <p class="text-sm text-slate-600">Los 5 detalles de un solo periodo donde se pierden más puntos en el tercer parcial.</p>
          </div>
          <div class="flex items-center gap-3 shrink-0">
            <div class="px-4 py-2 rounded-xl bg-slate-100 border border-slate-200 text-sm font-extrabold text-slate-800">
              Puntuación: <span id="quiz-score" class="text-violet-700">0</span> / 5
            </div>
            <button onclick="resetQuiz()"
              class="px-3.5 py-2 rounded-xl bg-white border border-slate-300 hover:bg-slate-100 text-xs font-bold text-slate-700 transition-all">
              Reiniciar
            </button>
          </div>
        </div>

        <div id="quiz-container" class="space-y-4"></div>
      </div>
    </section>

  </main>

  <footer class="border-t border-slate-200 bg-white mt-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-slate-500">
      <span><strong>Regla de oro del Parcial 3:</strong> Lo que se debe = Lo que se paga (evaluado siempre en la misma Fecha Focal).</span>
      <span>Laboratorio Visual · Teoría del Interés</span>
    </div>
  </footer>

  <script>
    /* =========================================================================
       UTILIDADES MATEMÁTICAS Y DE NOTACIÓN ACTUARIAL
    ========================================================================= */
    const mathA = (n, i) => `<span class="math-expr">a<sub><span class="act-angle">${n}</span>|${i}</sub></span>`;
    const mathADue = (n, i) => `<span class="math-expr"><span class="ddot">a</span><sub><span class="act-angle">${n}</span>|${i}</sub></span>`;
    const mathS = (n, i) => `<span class="math-expr">s<sub><span class="act-angle">${n}</span>|${i}</sub></span>`;
    const mathSDue = (n, i) => `<span class="math-expr"><span class="ddot">s</span><sub><span class="act-angle">${n}</span>|${i}</sub></span>`;
    const frac = (num, den) => `<span class="math-frac"><span class="num">${num}</span><span class="den">${den}</span></span>`;

    // Helper para crear elementos SVG
    const SVG_NS = "http://www.w3.org/2000/svg";
    function svgEl(tag, attrs = {}, text = null) {
      const el = document.createElementNS(SVG_NS, tag);
      for (const [k, v] of Object.entries(attrs)) {
        el.setAttribute(k, v);
      }
      if (text !== null) el.textContent = text;
      return el;
    }

    // Definición de puntas de flecha reutilizables en cualquier SVG
    function appendArrowDefs(svg, prefix) {
      const defs = svgEl("defs");
      const colors = [
        { id: `${prefix}-arrow-blue`, color: "#2563EB" },
        { id: `${prefix}-arrow-green`, color: "#059669" },
        { id: `${prefix}-arrow-orange`, color: "#EA580C" },
        { id: `${prefix}-arrow-purple`, color: "#7C3AED" },
        { id: `${prefix}-arrow-slate`, color: "#64748B" }
      ];
      colors.forEach(({ id, color }) => {
        const marker = svgEl("marker", {
          id,
          viewBox: "0 0 10 10",
          refX: "8",
          refY: "5",
          markerWidth: "7",
          markerHeight: "7",
          orient: "auto-start-reverse"
        });
        marker.appendChild(svgEl("path", { d: "M 0 1.2 L 10 5 L 0 8.8 z", fill: color }));
        defs.appendChild(marker);
      });
      svg.appendChild(defs);
    }

    /* =========================================================================
       NAVEGACIÓN DE PESTAÑAS
    ========================================================================= */
    function switchTab(tabNum) {
      stopExercisePlayback();
      [1, 2, 3].forEach((n) => {
        const panel = document.getElementById(`tab-panel-${n}`);
        const btn = document.getElementById(`tab-btn-${n}`);
        if (n === tabNum) {
          panel.classList.remove("hidden");
          btn.className = "tab-btn px-4 py-2.5 rounded-xl text-sm font-bold transition-all flex items-center gap-2 bg-orange-600 text-white shadow-sm";
          btn.setAttribute("aria-selected", "true");
        } else {
          panel.classList.add("hidden");
          btn.className = "tab-btn px-4 py-2.5 rounded-xl text-sm font-bold transition-all flex items-center gap-2 bg-slate-100 text-slate-700 hover:bg-slate-200";
          btn.setAttribute("aria-selected", "false");
        }
      });
      if (tabNum === 1) renderCompassSVG(false);
      if (tabNum === 2) renderExerciseView();
    }

    /* =========================================================================
       PESTAÑA 1: BRÚJULA ¿ADELANTE O ATRÁS?
    ========================================================================= */
    const compassState = {
      flow: "deferred", // single | ordinary | due | deferred
      mode: "vp",       // vp | vf
      ff: 0,            // 0..10
      phase: 2          // 0 = idle, 1 = phase 1, 2 = phase 1+2
    };

    let compassTimers = [];

    const FLOW_CONFIGS = {
      single: {
        name: "Flujo Único ($1,000 en t = 5)",
        payments: [5],
        amountLabel: "$1,000",
        supportsMode: false,
        dropPoint: () => 5,
        phase1Text: "Solo hay un flujo en t = 5, así que no hace falta agrupar pagos.",
        formulaBase: () => "1,000"
      },
      ordinary: {
        name: "Anualidad Vencida (pagos en t = 1..5)",
        payments: [1, 2, 3, 4, 5],
        amountLabel: "R",
        supportsMode: true,
        dropPoint: (mode) => (mode === "vp" ? 0 : 5),
        phase1Text: (mode) =>
          mode === "vp"
            ? "a_5|i agrupa los 5 pagos y SIEMPRE cae 1 periodo ANTES del primer pago → cae en t = 0."
            : "s_5|i agrupa los 5 pagos y SIEMPRE cae EN el último pago → cae en t = 5.",
        formulaBase: (mode) => (mode === "vp" ? `R · ${mathA(5, "i")}` : `R · ${mathS(5, "i")}`)
      },
      due: {
        name: "Anualidad Anticipada (pagos en t = 0..4)",
        payments: [0, 1, 2, 3, 4],
        amountLabel: "R",
        supportsMode: true,
        dropPoint: (mode) => (mode === "vp" ? 0 : 5),
        phase1Text: (mode) =>
          mode === "vp"
            ? "ä_5|i agrupa los 5 pagos y SIEMPRE cae EN el primer pago → cae en t = 0."
            : "s̈_5|i agrupa los 5 pagos y SIEMPRE cae 1 periodo DESPUÉS del último pago → cae en t = 5.",
        formulaBase: (mode) => (mode === "vp" ? `R · ${mathADue(5, "i")}` : `R · ${mathSDue(5, "i")}`)
      },
      deferred: {
        name: "Anualidad Diferida (pagos en t = 4..8)",
        payments: [4, 5, 6, 7, 8],
        amountLabel: "R",
        supportsMode: true,
        dropPoint: (mode) => (mode === "vp" ? 3 : 8),
        phase1Text: (mode) =>
          mode === "vp"
            ? "a_5|i agrupa los pagos (t=4..8) y SIEMPRE cae 1 periodo ANTES del primer pago → cae en t = 3 (¡no en 0!)."
            : "s_5|i agrupa los pagos (t=4..8) y SIEMPRE cae EN el último pago → cae en t = 8.",
        formulaBase: (mode) => (mode === "vp" ? `R · ${mathA(5, "i")}` : `R · ${mathS(5, "i")}`)
      }
    };

    function clearCompassTimers() {
      compassTimers.forEach((t) => clearTimeout(t));
      compassTimers = [];
    }

    function setCompassFlow(flowKey) {
      compassState.flow = flowKey;
      updateCompassButtons();
      runCompassAnimation();
    }

    function setCompassFormulaMode(mode) {
      compassState.mode = mode;
      updateCompassButtons();
      runCompassAnimation();
    }

    function setCompassFF(ff) {
      compassState.ff = ff;
      document.getElementById("ff-slider").value = ff;
      document.getElementById("ff-badge").textContent = `t = ${ff}`;
      runCompassAnimation();
    }

    function updateCompassButtons() {
      const cfg = FLOW_CONFIGS[compassState.flow];
      document.querySelectorAll(".flow-opt").forEach((btn) => {
        const active = btn.dataset.flow === compassState.flow;
        btn.className = active
          ? "flow-opt text-left px-3 py-2.5 rounded-xl border-2 border-orange-500 bg-orange-50 text-orange-900 text-xs sm:text-sm font-bold transition-all shadow-sm"
          : "flow-opt text-left px-3 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs sm:text-sm font-semibold transition-all";
      });

      const vpBtn = document.getElementById("compass-mode-vp");
      const vfBtn = document.getElementById("compass-mode-vf");
      if (!cfg.supportsMode) {
        vpBtn.disabled = true;
        vfBtn.disabled = true;
        vpBtn.className = "px-3 py-2.5 rounded-xl border border-slate-200 bg-slate-100 text-slate-400 text-xs sm:text-sm font-semibold text-left cursor-not-allowed";
        vfBtn.className = "px-3 py-2.5 rounded-xl border border-slate-200 bg-slate-100 text-slate-400 text-xs sm:text-sm font-semibold text-left cursor-not-allowed";
      } else {
        vpBtn.disabled = false;
        vfBtn.disabled = false;
        vpBtn.className =
          compassState.mode === "vp"
            ? "px-3 py-2.5 rounded-xl border-2 border-blue-500 bg-blue-50 text-blue-900 text-xs sm:text-sm font-bold text-left transition-all shadow-sm"
            : "px-3 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs sm:text-sm font-semibold text-left transition-all";
        vfBtn.className =
          compassState.mode === "vf"
            ? "px-3 py-2.5 rounded-xl border-2 border-emerald-500 bg-emerald-50 text-emerald-900 text-xs sm:text-sm font-bold text-left transition-all shadow-sm"
            : "px-3 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs sm:text-sm font-semibold text-left transition-all";
      }
    }

    function runCompassAnimation() {
      clearCompassTimers();
      compassState.phase = 1;
      renderCompassSVG(true);
      updateCompassPhasePills(1);
      renderCompassExplanation();

      const t1 = setTimeout(() => {
        compassState.phase = 2;
        renderCompassSVG(true);
        updateCompassPhasePills(2);
      }, 900);
      compassTimers.push(t1);
    }

    function updateCompassPhasePills(phase) {
      const p1 = document.getElementById("phase-pill-1");
      const p2 = document.getElementById("phase-pill-2");
      const cfg = FLOW_CONFIGS[compassState.flow];
      const drop = cfg.dropPoint(compassState.mode);
      const diff = compassState.ff - drop;

      if (phase >= 1) {
        p1.className = "px-3 py-1 rounded-full bg-slate-800 text-white transition-all shadow-sm";
      } else {
        p1.className = "px-3 py-1 rounded-full bg-slate-200 text-slate-600 transition-all";
      }

      if (phase >= 2) {
        if (diff < 0) {
          p2.className = "px-3 py-1 rounded-full bg-blue-600 text-white transition-all shadow-sm";
        } else if (diff > 0) {
          p2.className = "px-3 py-1 rounded-full bg-emerald-600 text-white transition-all shadow-sm";
        } else {
          p2.className = "px-3 py-1 rounded-full bg-orange-600 text-white transition-all shadow-sm";
        }
      } else {
        p2.className = "px-3 py-1 rounded-full bg-slate-200 text-slate-600 transition-all";
      }
    }

    function renderCompassSVG(animate) {
      const svg = document.getElementById("compass-svg");
      svg.innerHTML = "";
      appendArrowDefs(svg, "cmp");

      const cfg = FLOW_CONFIGS[compassState.flow];
      const drop = cfg.dropPoint(compassState.mode);
      const ff = compassState.ff;
      const diff = ff - drop;

      const xStart = 60;
      const xEnd = 860;
      const stepX = (xEnd - xStart) / 10;
      const axisY = 185;
      const xAt = (t) => xStart + t * stepX;

      // Hint en barra superior
      const hintEl = document.getElementById("compass-pin-hint");
      if (cfg.supportsMode) {
        hintEl.textContent = `Pin de fórmula en t = ${drop} | Fecha Focal en t = ${ff}`;
      } else {
        hintEl.textContent = `Flujo único en t = 5 | Fecha Focal en t = ${ff}`;
      }

      // Eje horizontal
      svg.appendChild(svgEl("line", {
        x1: xStart - 20, y1: axisY, x2: xEnd + 20, y2: axisY,
        stroke: "#94A3B8", "stroke-width": 3, "stroke-linecap": "round"
      }));

      // Resaltado zona de gracia en diferida
      if (compassState.flow === "deferred") {
        svg.appendChild(svgEl("rect", {
          x: xAt(0), y: axisY - 12, width: xAt(3) - xAt(0), height: 24,
          rx: 6, fill: "#F1F5F9", stroke: "#CBD5E1", "stroke-dasharray": "4 3"
        }));
        svg.appendChild(svgEl("text", {
          x: (xAt(0) + xAt(3)) / 2, y: axisY + 4,
          "text-anchor": "middle", "font-size": 10.5, "font-weight": "700", fill: "#64748B"
        }, "Meses sin pago"));
      }

      // Marcas t = 0..10 clicables para mover Fecha Focal
      for (let t = 0; t <= 10; t++) {
        const x = xAt(t);
        const isFF = t === ff;
        const g = svgEl("g", { class: "cursor-pointer" });
        g.addEventListener("click", () => setCompassFF(t));

        // Área invisible cómoda para tocar
        g.appendChild(svgEl("rect", {
          x: x - 22, y: axisY - 20, width: 44, height: 64, fill: "transparent"
        }));

        g.appendChild(svgEl("line", {
          x1: x, y1: axisY - 8, x2: x, y2: axisY + 8,
          stroke: isFF ? "#EA580C" : "#64748B", "stroke-width": isFF ? 3.5 : 2
        }));

        // Etiqueta clicable
        if (isFF) {
          g.appendChild(svgEl("rect", {
            x: x - 22, y: axisY + 14, width: 44, height: 24, rx: 8,
            fill: "#EA580C"
          }));
          g.appendChild(svgEl("text", {
            x, y: axisY + 30, "text-anchor": "middle", "font-size": 12, "font-weight": "800", fill: "#FFFFFF"
          }, `t=${t}`));
        } else {
          g.appendChild(svgEl("text", {
            x, y: axisY + 30, "text-anchor": "middle", "font-size": 12, "font-weight": "600", fill: "#475569"
          }, `t=${t}`));
        }
        svg.appendChild(g);
      }

      // Línea vertical de Fecha Focal (FF)
      const xFF = xAt(ff);
      svg.appendChild(svgEl("line", {
        x1: xFF, y1: 30, x2: xFF, y2: axisY + 12,
        stroke: "#EA580C", "stroke-width": 2.5, "stroke-dasharray": "6 4"
      }));
      svg.appendChild(svgEl("rect", {
        x: xFF - 46, y: 10, width: 92, height: 24, rx: 12, fill: "#EA580C"
      }));
      svg.appendChild(svgEl("text", {
        x: xFF, y: 26, "text-anchor": "middle", "font-size": 11.5, "font-weight": "800", fill: "#FFFFFF"
      }, `FECHA FOCAL`));

      // Dibujar los pagos en la línea de tiempo (hacia abajo desde el eje o círculos arriba)
      cfg.payments.forEach((p) => {
        const x = xAt(p);
        svg.appendChild(svgEl("line", {
          x1: x, y1: axisY, x2: x, y2: axisY + 62,
          stroke: "#334155", "stroke-width": 2.5, "marker-end": "url(#cmp-arrow-slate)"
        }));
        svg.appendChild(svgEl("circle", {
          cx: x, cy: axisY, r: 5.5, fill: "#0F172A", stroke: "#FFFFFF", "stroke-width": 2
        }));
        svg.appendChild(svgEl("text", {
          x, y: axisY + 80, "text-anchor": "middle", "font-size": 12, "font-weight": "700", fill: "#1E293B"
        }, cfg.amountLabel));
      });

      // FASE 1: Agrupación de la anualidad hacia su punto de caída (drop)
      if (compassState.phase >= 1 && cfg.supportsMode) {
        const pFirst = cfg.payments[0];
        const pLast = cfg.payments[cfg.payments.length - 1];
        const isVP = compassState.mode === "vp";
        const groupColor = isVP ? "#2563EB" : "#059669";
        const marker = isVP ? "url(#cmp-arrow-blue)" : "url(#cmp-arrow-green)";

        // Llave / caja de agrupación sobre los pagos
        const x1 = xAt(pFirst) - 10;
        const x2 = xAt(pLast) + 10;
        svg.appendChild(svgEl("rect", {
          x: x1, y: axisY + 46, width: x2 - x1, height: 46, rx: 10,
          fill: isVP ? "rgba(37,99,235,0.08)" : "rgba(5,150,105,0.08)",
          stroke: groupColor, "stroke-width": 1.8, "stroke-dasharray": "5 3"
        }));

        // Curvas sutiles desde los extremos hacia el punto de caída
        const xDrop = xAt(drop);
        const startX = isVP ? xAt(pLast) : xAt(pFirst);
        const midX = (startX + xDrop) / 2;
        const curveY = axisY - 46;
        svg.appendChild(svgEl("path", {
          d: `M ${startX} ${axisY - 8} Q ${midX} ${curveY} ${xDrop} ${axisY - 12}`,
          fill: "none",
          stroke: groupColor,
          "stroke-width": 2.6,
          "stroke-dasharray": "5 4",
          "marker-end": marker,
          class: animate ? "animate-draw" : ""
        }));

        // Pin brillante donde cae la fórmula
        svg.appendChild(svgEl("circle", {
          cx: xDrop, cy: axisY, r: 15,
          fill: isVP ? "rgba(37,99,235,0.22)" : "rgba(5,150,105,0.22)",
          class: "pin-pulse"
        }));
        svg.appendChild(svgEl("circle", {
          cx: xDrop, cy: axisY, r: 8,
          fill: groupColor, stroke: "#FFFFFF", "stroke-width": 2.5
        }));

        // Etiqueta del pin
        const pinLabel =
          compassState.flow === "due"
            ? isVP ? "ä cae aquí" : "s̈ cae aquí"
            : isVP ? "a cae aquí" : "s cae aquí";
        svg.appendChild(svgEl("rect", {
          x: xDrop - 42, y: axisY - 40, width: 84, height: 22, rx: 11, fill: groupColor
        }));
        svg.appendChild(svgEl("text", {
          x: xDrop, y: axisY - 25, "text-anchor": "middle", "font-size": 11, "font-weight": "800", fill: "#FFFFFF"
        }, pinLabel));
      }

      // Si es flujo único, también marcamos su pin en t=5
      if (compassState.phase >= 1 && !cfg.supportsMode) {
        const xDrop = xAt(5);
        svg.appendChild(svgEl("circle", {
          cx: xDrop, cy: axisY, r: 13, fill: "rgba(15,23,42,0.12)", class: "pin-pulse"
        }));
        svg.appendChild(svgEl("circle", {
          cx: xDrop, cy: axisY, r: 7, fill: "#0F172A", stroke: "#FFFFFF", "stroke-width": 2
        }));
      }

      // FASE 2: Traslado desde el punto de caída (drop) hasta la Fecha Focal (ff)
      if (compassState.phase >= 2) {
        const xDrop = xAt(drop);
        if (diff === 0) {
          // Ya está en la Fecha Focal
          svg.appendChild(svgEl("rect", {
            x: xFF - 106, y: 52, width: 212, height: 34, rx: 12,
            fill: "#FFF7ED", stroke: "#EA580C", "stroke-width": 2
          }));
          svg.appendChild(svgEl("text", {
            x: xFF, y: 73, "text-anchor": "middle", "font-size": 12.5, "font-weight": "800", fill: "#C2410C"
          }, "¡Ya estás en la Fecha Focal! (k = 0)"));
        } else {
          const isBack = diff < 0;
          const k = Math.abs(diff);
          const color = isBack ? "#2563EB" : "#059669";
          const marker = isBack ? "url(#cmp-arrow-blue)" : "url(#cmp-arrow-green)";
          const midX = (xDrop + xFF) / 2;
          const arcTopY = 58;

          const pathD = `M ${xDrop} ${axisY - 14} C ${xDrop} ${arcTopY}, ${xFF} ${arcTopY}, ${xFF} ${axisY - 14}`;
          const arcPath = svgEl("path", {
            d: pathD,
            fill: "none",
            stroke: color,
            "stroke-width": 4,
            "marker-end": marker,
            class: animate ? "animate-draw" : ""
          });
          svg.appendChild(arcPath);

          // Partícula viajando sobre la flecha (animación SMIL nativa sin librerías)
          if (animate) {
            const dot = svgEl("circle", { r: 5.5, fill: color, stroke: "#FFFFFF", "stroke-width": 1.8 });
            const animMotion = svgEl("animateMotion", {
              dur: "1.1s",
              repeatCount: "1",
              fill: "freeze",
              path: pathD
            });
            dot.appendChild(animMotion);
            svg.appendChild(dot);
          }

          // Etiqueta de factor sobre la curva
          const badgeText = isBack
            ? `← ATRÁS ${k} per. · ×(1+i)^-${k}`
            : `ADELANTE ${k} per. → · ×(1+i)^+${k}`;
          const badgeW = 205;
          const bx = Math.max(20, Math.min(900 - badgeW, midX - badgeW / 2));
          svg.appendChild(svgEl("rect", {
            x: bx, y: 48, width: badgeW, height: 30, rx: 15,
            fill: isBack ? "#EFF6FF" : "#ECFDF5", stroke: color, "stroke-width": 2
          }));
          svg.appendChild(svgEl("text", {
            x: bx + badgeW / 2, y: 67, "text-anchor": "middle", "font-size": 12, "font-weight": "800", fill: color
          }, badgeText));
        }
      }
    }

    function renderCompassExplanation() {
      const box = document.getElementById("compass-explanation");
      const cfg = FLOW_CONFIGS[compassState.flow];
      const drop = cfg.dropPoint(compassState.mode);
      const ff = compassState.ff;
      const diff = ff - drop;
      const k = Math.abs(diff);

      const baseFormula = cfg.formulaBase(compassState.mode);
      let moveFormula = "";
      let dirBadge = "";
      let explanationText = "";

      if (diff === 0) {
        moveFormula = `<span class="text-orange-600 font-bold">(sin factor extra, k = 0)</span>`;
        dirBadge = `<span class="px-3 py-1 rounded-full bg-orange-100 text-orange-800 text-xs font-extrabold">Mismo punto · Sin traslado</span>`;
        explanationText = `Tu fórmula ya te dejó exactamente en <strong>t = ${ff}</strong>, que coincide con tu Fecha Focal. No necesitas multiplicar por (1+i)<sup>±k</sup>.`;
      } else if (diff < 0) {
