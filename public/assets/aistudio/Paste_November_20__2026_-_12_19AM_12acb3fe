      document.getElementById("btn-prev-step").classList.toggle("opacity-40", exState.step === 1);
      document.getElementById("btn-next-step").disabled = exState.step === 4;
      document.getElementById("btn-next-step").classList.toggle("opacity-40", exState.step === 4);

