    function computeWizardRecommendation() {
      const { q1, q2, q3 } = wizState;

      // Caso 1: Saldos insolutos
      if (q1 === "saldo") {
        if (q2 === "d_r_non") {
          return {
            color: "emerald",
            dir: "ADELANTE (Verde · Miras al pasado)",
            title: "Saldo Insoluto — Método Retrospectivo",
            formula: `SI<sub>k</sub> = D(1 + i)<sup>k</sup> − R · ${mathS("k", "i")}`,
            trick: "Como NO conoces el total de pagos n, miras hacia atrás: llevas la deuda D y los k pagos ya hechos hacia ADELANTE hasta el corte k y los restas (como en tu Ej. 8)."
          };
        }
        if (q3 === "start") {
          return {
            color: "purple",
            dir: "ATRÁS con trampa «Justo Antes» (Morado/Azul)",
            title: "Saldo Insoluto Prospectivo — Justo ANTES del pago k",
            formula: `SI<sub>k<sup>−</sup></sub> = R · ${mathADue("n−k+1", "i")} = R · ${mathA("n−k+1", "i")} · (1 + i)`,
            trick: "Justo ANTES de pagar el pago k todavía lo debes hoy. Cuenta cuántos pagos quedan INCLUYENDO el de hoy y usa anualidad anticipada (como en tu Ej. 7)."
          };
        }
        return {
          color: "blue",
          dir: "ATRÁS (Azul · Miras al futuro)",
          title: "Saldo Insoluto — Método Prospectivo",
          formula: `SI<sub>k</sub> = R · ${mathA("n−k", "i")}`,
          trick: "Conoces R y n. Solo cuenta cuántos pagos FALTAN (n − k) y tráelos hacia ATRÁS al momento k con a_(n−k)|i (como en tu Ej. 6)."
        };
      }

      // Caso 2: Pagos extra
      if (q1 === "extra") {
        const atSame = q3 === "start";
        return {
          color: "purple",
          dir: "Primero ATRÁS a t = 0, luego faltante ADELANTE",
          title: atSame ? "Pago Extra EN el último pago completo (t = n)" : "Pago Extra 1 periodo DESPUÉS del último completo (t = n + 1)",
          formula: atSame
            ? `D = R · ${mathA("n", "i")} + X(1+i)<sup>−n</sup> &nbsp;⇒&nbsp; X = (D − R·${mathA("n", "i")})(1+i)<sup>+n</sup>`
            : `D = R · ${mathA("n", "i")} + X(1+i)<sup>−(n+1)</sup> &nbsp;⇒&nbsp; X = (D − R·${mathA("n", "i")})(1+i)<sup>+(n+1)</sup>`,
          trick: "Paso 1: Halla n con logaritmos y quédate con la parte entera. Paso 2: Calcula cuánto falta en t = 0. Paso 3: Avanza ese faltante hasta el mes exacto donde te pidan X (n si es junto al último pago como Ej. 5; n+1 si es un mes después como Ej. 4)."
        };
      }

      // Caso 3: Valor futuro / Ahorro
      if (q1 === "vf") {
        if (q3 === "start") {
          return {
            color: "emerald",
            dir: "ADELANTE (Verde · Anualidad Anticipada)",
            title: "Monto Futuro con Anualidad Anticipada (retiro 1 periodo después)",
            formula: `M = R · ${mathSDue("n", "i")} = R · ${mathS("n", "i")} · (1 + i)`,
            trick: "Si el dinero se retira 1 mes después del último depósito (como en tu Ej. 3) o los depósitos son al inicio del mes, s_n|i se multiplica por (1 + i)."
          };
        }
        return {
          color: "emerald",
          dir: "ADELANTE (Verde · Capitalizar)",
          title: "Monto Futuro con Anualidad Vencida",
          formula: `M = R · ${mathS("n", "i")} = R · ${frac("(1 + i)<sup>n</sup> − 1", "i")}`,
          trick: "s_n|i acumula todos los depósitos hacia ADELANTE y cae EXACTAMENTE en la fecha del último depósito."
        };
      }

