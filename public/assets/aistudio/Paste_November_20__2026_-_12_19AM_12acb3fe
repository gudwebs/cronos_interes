        noteEl.innerHTML = dyn.note.html;
      } else {
        noteEl.className = "hidden";
      }

      // Desarrollo matemático (se revela progresivamente o resalta el paso activo)
      const mathContainer = document.getElementById("ex-math-steps");
      mathContainer.innerHTML = dyn.mathSteps
        .map((line, idx) => {
          const isFinalHighlight = exState.step === 4 && idx === dyn.mathSteps.length - 1;
          const isDimmed = exState.step < 3 && idx > 0;
          return `<div class="px-3.5 py-2.5 rounded-xl border transition-all ${
            isFinalHighlight
              ? "bg-emerald-50 border-emerald-300 shadow-sm"
              : isDimmed
              ? "bg-white/60 border-slate-200/70 opacity-50"
              : "bg-white border-slate-200"
