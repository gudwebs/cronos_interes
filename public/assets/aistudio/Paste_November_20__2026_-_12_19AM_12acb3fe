      if (q3 === "deferred") {
        return {
          color: "blue",
          dir: "ATRÁS en 2 brincos (Azul · Diferida)",
          title: "Anualidad Diferida (con periodo de gracia)",
          formula: `D = R · ${mathA("n", "i")} · (1 + i)<sup>−k</sup> &nbsp;&nbsp;(ó &nbsp; D(1+i)<sup>+k</sup> = R · ${mathA("n", "i")})`,
          trick: "Si el primer pago es en el mes m, a_n|i cae en m − 1. Por eso k = m − 1 (ejemplo: primer pago en mes 4 ⇒ k = 3, como en tus Ej. 1 y 2)."
        };
