        return {
          color: "blue",
          dir: "ATRÁS (Azul · Anticipada)",
          title: "Valor Presente de Anualidad Anticipada",
          formula: `D = R · ${mathADue("n", "i")} = R · ${mathA("n", "i")} · (1 + i)`,
          trick: "Como el primer pago es HOY (t = 0), ä_n|i cae directamente en el primer pago sin tener que mover nada extra."
        };
